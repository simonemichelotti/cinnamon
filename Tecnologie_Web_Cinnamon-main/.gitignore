# Cinnamon — .gitignore
# Generated for a Django project

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
.venv/
env/
.env/

# Environment variables
.env
.env.*
!.env.example

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Media files (uploaded by users — not to be committed)
media/

# Static files collected (generated by collectstatic)
staticfiles/
static_root/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Pipenv lock (optional — uncomment if you prefer not to track it)
# Pipfile.lock
